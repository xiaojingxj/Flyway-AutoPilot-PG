table "public"."users" {
  primaryKey = {
    columns = [
      "id"
    ]
    name = "users_pkey"
    objectType = primaryKey
  }
  owner = postgres
  columns = (
    column "id" {
      type = integer
      null = NOT NULL
      default = nextval('public.users_id_seq'::regclass)
    }
    column "username" {
      type = character varying(50)
      null = NOT NULL
    }
    column "email" {
      type = character varying(100)
      null = NOT NULL
    }
    column "created_at" {
      type = timestamp without time zone
      default = CURRENT_TIMESTAMP
    }
  )
}

